{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": false,
    "noEmit": false,
    "isolatedModules": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  "exclude": ["dist", "node_modules", "**/*.spec.ts"]
}
