generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  PARTNER
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuditAction {
  REGISTER_VALIDATION_FAILED
  REGISTER_RATE_LIMITED
  REGISTER_OTP_RESENT
  REGISTER_CREATED
  REGISTER_OTP_SENT
  SCHOLARSHIP_CREATED
  SCHOLARSHIP_SUBMITTED
  SCHOLARSHIP_APPROVED
  SCHOLARSHIP_REJECTED
  APPLICATION_SUBMITTED
  APPLICATION_STATUS_CHANGED
  ADMIN_LOGIN_SUCCEEDED
  ADMIN_REFRESH_ROTATED
  ADMIN_LOGOUT
  ADMIN_REFRESH_REUSE_BLOCKED
  ADMIN_USER_SOFT_DELETED
  ADMIN_LOGIN_RATE_LIMITED
  ADMIN_SCHOLARSHIP_APPROVED
  ADMIN_SCHOLARSHIP_REJECTED
  ADMIN_ORGANIZATION_VERIFIED
  ADMIN_ORGANIZATION_REJECTED
  ADMIN_USER_UPDATED
  ADMIN_APPLICATION_STATUS_CHANGED
  ADMIN_CONSULT_UPDATED
  ADMIN_CONTENT_UPDATED
  ADMIN_SETTINGS_UPDATED
  ADMIN_NOTIFICATION_UPDATED
  ADMIN_TRASH_RESTORED
  ADMIN_TRASH_PURGED
  ADMIN_REPORT_UPDATED
  ADMIN_EMAIL_TEST_SENT
  ADMIN_PROFILE_SECURITY_UPDATED
  ADMIN_REPORT_SCHEDULE_UPDATED
}

enum OrganizationStatus {
  PENDING
  VERIFIED
  REJECTED
  NEEDS_MORE_INFO
  SUSPENDED
}

enum ScholarshipStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  CLOSED
  ARCHIVED
  EXPIRED
  REMOVED
}

enum ScholarshipType {
  FULL
  PARTIAL
  GRANT
  OTHER
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  REVIEWING
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
  NEEDS_INTERVENTION
}

enum DocumentType {
  CV
  TRANSCRIPT
  CERTIFICATE
  RECOMMENDATION
  OTHER
}

enum ConsultStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum ConsultPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum TaxonomyType {
  MAJOR
  REGION
  COUNTRY
  SCHOLARSHIP_TYPE
  DOCUMENT_TYPE
  EDUCATION_LEVEL
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum ReportStatus {
  NEW
  REVIEWING
  RESOLVED
  DISMISSED
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                       String                     @id @default(uuid())
  email                    String?                    @unique
  phone                    String?                    @unique
  passwordHash             String
  role                     UserRole                   @default(CANDIDATE)
  status                   UserStatus                 @default(PENDING_VERIFICATION)
  emailVerified            Boolean                    @default(false)
  phoneVerified            Boolean                    @default(false)
  emailVerifiedAt          DateTime?
  phoneVerifiedAt          DateTime?
  lastLoginAt              DateTime?
  totpSecret               String?
  totpEnabled              Boolean                    @default(false)
  deletedAt                DateTime?
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  profile                  Profile?
  memberships              OrganizationMember[]
  createdScholarships      Scholarship[]              @relation("ScholarshipCreator")
  candidateApplications    Application[]              @relation("ApplicationCandidate")
  reviewedApplications     Application[]              @relation("ApplicationReviewer")
  applicationStatusChanges ApplicationStatusHistory[]
  auditLogs                AuditLog[]                 @relation("UserAuditLogs")
  notifications            Notification[]
  refreshTokens            RefreshToken[]
  savedScholarships        SavedScholarship[]
  requestedConsults        ConsultRequest[]           @relation("ConsultRequester")
  assignedConsults         ConsultRequest[]           @relation("ConsultAssignee")
  consultMessages          ConsultMessage[]
  authoredPosts            Post[]
  reports                  AbuseReport[]              @relation("ReportReporter")

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
}

model Profile {
  id             String   @id @default(uuid())
  userId         String   @unique
  fullName       String?
  phone          String?
  avatarUrl      String?
  bio            String?
  gpa            Float?
  educationLevel String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Organization {
  id                 String                 @id @default(uuid())
  name               String
  normalizedName     String?
  slug               String                 @unique
  description        String?
  logoUrl            String?
  type               String?
  taxCode            String?                @unique
  website            String?
  representativeName String?
  verified           Boolean                @default(false)
  status             OrganizationStatus     @default(PENDING)
  submittedAt        DateTime?
  verifiedAt         DateTime?
  reviewerId         String?
  deletedAt          DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  members            OrganizationMember[]
  scholarships       Scholarship[]
  documents          OrganizationDocument[]

  @@index([status, submittedAt])
  @@index([normalizedName])
  @@index([deletedAt])
}

model OrganizationMember {
  organizationId String
  userId         String
  isOwner        Boolean      @default(false)
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
}

model Scholarship {
  id                String                @id @default(uuid())
  organizationId    String
  createdById       String
  title             String
  slug              String                @unique
  summary           String
  description       String
  country           String?
  region            String?
  field             String?
  degreeLevel       String?
  type              ScholarshipType       @default(OTHER)
  amount            String?
  eligibility       Json?
  requiredDocuments Json?
  deadline          DateTime?
  status            ScholarshipStatus     @default(DRAFT)
  viewCount         Int                   @default(0)
  isFeatured        Boolean               @default(false)
  featuredOrder     Int                   @default(0)
  submittedAt       DateTime?
  publishedAt       DateTime?
  reviewerId        String?
  rejectionReason   String?
  deletedAt         DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  creator           User                  @relation("ScholarshipCreator", fields: [createdById], references: [id])
  organization      Organization          @relation(fields: [organizationId], references: [id])
  applications      Application[]
  savedBy           SavedScholarship[]
  revisions         ScholarshipRevision[]
  majors            ScholarshipMajor[]
  consultRequests   ConsultRequest[]
  reports           AbuseReport[]

  @@index([country, field, degreeLevel])
  @@index([status, deadline])
  @@index([status, submittedAt])
  @@index([isFeatured, featuredOrder])
  @@index([organizationId])
  @@index([deletedAt])
}

model Application {
  id            String                     @id @default(uuid())
  candidateId   String
  scholarshipId String
  reviewerId    String?
  status        ApplicationStatus          @default(DRAFT)
  coverLetter   String?
  submittedAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  candidate     User                       @relation("ApplicationCandidate", fields: [candidateId], references: [id])
  reviewer      User?                      @relation("ApplicationReviewer", fields: [reviewerId], references: [id])
  scholarship   Scholarship                @relation(fields: [scholarshipId], references: [id])
  documents     ApplicationDocument[]
  statusHistory ApplicationStatusHistory[]
  riskFlags     Json?
  adminNote     String?

  @@unique([candidateId, scholarshipId])
  @@index([status, scholarshipId])
  @@index([status, submittedAt])
  @@index([deletedAt])
}

model ApplicationDocument {
  id            String       @id @default(uuid())
  applicationId String
  type          DocumentType
  fileName      String
  storageKey    String
  contentType   String
  size          Int
  createdAt     DateTime     @default(now())
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, type])
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String
  note          String?
  createdAt     DateTime           @default(now())
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User               @relation(fields: [changedById], references: [id])

  @@index([applicationId, createdAt])
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  type      String               @default("SYSTEM")
  priority  NotificationPriority @default(NORMAL)
  title     String
  body      String
  actionUrl String?
  readAt    DateTime?
  createdAt DateTime             @default(now())
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([type, priority, createdAt])
}

model SavedScholarship {
  userId        String
  scholarshipId String
  createdAt     DateTime    @default(now())
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, scholarshipId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditLog {
  id             String      @id @default(uuid())
  actorId        String?
  action         AuditAction
  entityType     String
  entityId       String?
  accountKeyHash String?
  ipHash         String?
  userAgentHash  String?
  reason         String?
  metadata       Json?
  createdAt      DateTime    @default(now())
  actor          User?       @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([accountKeyHash])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model OrganizationDocument {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  fileName       String
  storageKey     String
  contentType    String
  size           Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
}

model ScholarshipRevision {
  id            String      @id @default(uuid())
  scholarshipId String
  version       Int
  snapshot      Json
  createdById   String
  createdAt     DateTime    @default(now())
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, version])
  @@index([scholarshipId, createdAt])
}

model AdminNote {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  authorId   String
  content    String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([authorId])
}

model ConsultRequest {
  id               String           @id @default(uuid())
  requesterId      String?
  guestName        String?
  guestEmail       String?
  subject          String
  content          String
  scholarshipId    String?
  status           ConsultStatus    @default(OPEN)
  priority         ConsultPriority  @default(NORMAL)
  assigneeId       String?
  slaDueAt         DateTime?
  firstRespondedAt DateTime?
  resolvedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  requester        User?            @relation("ConsultRequester", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee         User?            @relation("ConsultAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  scholarship      Scholarship?     @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)
  messages         ConsultMessage[]

  @@index([status, priority, slaDueAt])
  @@index([assigneeId, status])
  @@index([deletedAt])
}

model ConsultMessage {
  id        String         @id @default(uuid())
  requestId String
  authorId  String?
  content   String
  internal  Boolean        @default(false)
  createdAt DateTime       @default(now())
  request   ConsultRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model ReplyTemplate {
  id        String   @id @default(uuid())
  name      String
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id             String         @id @default(uuid())
  title          String
  slug           String         @unique
  excerpt        String?
  content        String
  coverImage     String?
  tags           String[]
  category       String?
  status         ContentStatus  @default(DRAFT)
  publishedAt    DateTime?
  scheduledAt    DateTime?
  authorId       String
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  viewCount      Int            @default(0)
  deletedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  author         User           @relation(fields: [authorId], references: [id])
  revisions      PostRevision[]

  @@index([status, publishedAt])
  @@index([category])
  @@index([deletedAt])
}

model PostRevision {
  id        String   @id @default(uuid())
  postId    String
  snapshot  Json
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model Banner {
  id         String    @id @default(uuid())
  title      String
  desktopUrl String
  mobileUrl  String?
  linkUrl    String?
  sortOrder  Int       @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([active, sortOrder])
  @@index([deletedAt])
}

model StaticPage {
  id          String        @id @default(uuid())
  key         String        @unique
  title       String
  content     String
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  updatedAt   DateTime      @updatedAt
  createdAt   DateTime      @default(now())
}

model Taxonomy {
  id        String       @id @default(uuid())
  type      TaxonomyType
  name      String
  slug      String
  parentId  String?
  sortOrder Int          @default(0)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parent    Taxonomy?    @relation("TaxonomyTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Taxonomy[]   @relation("TaxonomyTree")

  @@unique([type, slug])
  @@index([type, parentId, sortOrder])
}

model Major {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  parentId     String?
  sortOrder    Int                @default(0)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  parent       Major?             @relation("MajorTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Major[]            @relation("MajorTree")
  scholarships ScholarshipMajor[]

  @@index([parentId, sortOrder])
}

model ScholarshipMajor {
  scholarshipId String
  majorId       String
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  major         Major       @relation(fields: [majorId], references: [id], onDelete: Restrict)

  @@id([scholarshipId, majorId])
  @@index([majorId])
}

model EmailTemplate {
  id        String                  @id @default(uuid())
  key       String                  @unique
  subject   String
  content   String
  variables String[]
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  revisions EmailTemplateRevision[]
}

model EmailTemplateRevision {
  id         String        @id @default(uuid())
  templateId String
  subject    String
  content    String
  editorId   String
  createdAt  DateTime      @default(now())
  template   EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
}

model NotificationPreference {
  id        String   @id @default(uuid())
  userId    String
  type      String
  email     Boolean  @default(true)
  inApp     Boolean  @default(true)
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model AbuseReport {
  id            String       @id @default(uuid())
  reporterId    String?
  scholarshipId String?
  reason        String
  details       String?
  status        ReportStatus @default(NEW)
  assigneeId    String?
  resolution    String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  reporter      User?        @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  scholarship   Scholarship? @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([scholarshipId])
}

model EmailDelivery {
  id           String         @id @default(uuid())
  recipient    String
  type         String
  subject      String
  status       DeliveryStatus @default(QUEUED)
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())

  @@index([status, createdAt])
  @@index([recipient])
}

model AnalyticsEvent {
  id            String   @id @default(uuid())
  userId        String?
  scholarshipId String?
  eventType     String
  source        String?
  sessionId     String?
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([source, createdAt])
  @@index([scholarshipId, eventType])
}

model ReportSchedule {
  id          String          @id @default(uuid())
  recipient   String
  frequency   ReportFrequency
  active      Boolean         @default(true)
  nextRunAt   DateTime
  lastRunAt   DateTime?
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([active, nextRunAt])
}
